# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交
TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：默认发送目标（chat_id 或 @channel）
TG_CHAT_ID=

# ---- Telegram ↔ Cline 桥（tools/tg_bridge.mjs）----
# 允许 agent 使用工具（读写文件/跑命令）；1=开启
TG_BRIDGE_TOOLS=1
# 自动批准工具调用（无人值守时必需）；1=开启
TG_BRIDGE_AUTO_APPROVE=1
# 允许对话的 chat 白名单（逗号分隔；留空=所有人）
# TG_ALLOWED_CHATS=
# 模型与运行模式
# TG_BRIDGE_PROVIDER=cline
# TG_BRIDGE_MODEL=cline-cloud/deepseek-v4.1-flash
# TG_BRIDGE_MODE=act
# 单轮超时（毫秒）
# TG_BRIDGE_TURN_TIMEOUT_MS=300000
